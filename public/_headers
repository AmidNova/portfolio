# Cloudflare Pages response headers. Keep in step with vercel.json;
# scripts/check-csp.mjs (CI) fails if the inline theme script's hash drifts.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-ILRJjH51pNXNiM7xUpisFuxGmp/DAJdjU1qCve9NPQc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build output never changes in place: cache it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
